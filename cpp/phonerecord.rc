#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_PHONERECORD ICON "assets/phonerecord.ico"

1 VERSIONINFO
 FILEVERSION 2,4,1,0
 PRODUCTVERSION 2,4,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "PhoneRecord 通话录音工具\0"
            VALUE "FileVersion", "2.4.1\0"
            VALUE "InternalName", "PhoneRecord\0"
            VALUE "OriginalFilename", "PhoneRecord.exe\0"
            VALUE "ProductName", "PhoneRecord\0"
            VALUE "ProductVersion", "2.4.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
