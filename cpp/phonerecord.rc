#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "product_version.h"

IDI_PHONERECORD ICON "assets/phonerecord.ico"

#ifdef PHONERECORD_X64
1901 RCDATA "speech/install.ps1"
1902 RCDATA "speech/worker.cjs"
1903 RCDATA "speech/NOTICE.md"
1904 RCDATA "speech/qwen-install.ps1"
1905 RCDATA "speech/qwen-worker.py"
1906 RCDATA "speech/qwen-assets.json"
#endif

IDD_RENAME_CALL DIALOGEX 0, 0, 340, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename call"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_RENAME_INFO, 12, 10, 316, 24, SS_LEFT | SS_NOPREFIX
    LTEXT "", IDC_RENAME_LABEL, 12, 39, 316, 12
    EDITTEXT IDC_RENAME_TITLE, 12, 54, 316, 20, ES_AUTOHSCROLL
    LTEXT "", IDC_RENAME_HINT, 12, 80, 316, 28, SS_LEFT | SS_NOPREFIX
    PUSHBUTTON "", IDC_RENAME_RESET, 12, 119, 112, 22
    DEFPUSHBUTTON "", IDOK, 192, 119, 64, 22
    PUSHBUTTON "", IDCANCEL, 264, 119, 64, 22
END

1 VERSIONINFO
 FILEVERSION PHONERECORD_VERSION_RESOURCE
 PRODUCTVERSION PHONERECORD_VERSION_RESOURCE
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "PhoneRecord 通话录音工具\0"
            VALUE "FileVersion", PHONERECORD_VERSION "\0"
            VALUE "InternalName", "PhoneRecord\0"
            VALUE "OriginalFilename", "PhoneRecord.exe\0"
            VALUE "ProductName", "PhoneRecord\0"
            VALUE "ProductVersion", PHONERECORD_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
